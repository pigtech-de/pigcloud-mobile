<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="AppTheme" parent="Theme.AppCompat.Light.DarkActionBar">
        <item name="colorPrimary">#B33791</item>
        <item name="colorPrimaryDark">@color/ic_launcher_background_dark</item>
        <item name="colorAccent">#DB8DD0</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background_dark</item>
        <item name="android:statusBarColor">@color/ic_launcher_background_dark</item>
    </style>

    <style name="AppTheme.NoActionBar" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:background">@null</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background_light</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/AppTheme.NoActionBar</item>
        <item name="android:background">@drawable/splash</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background_light</item>
        <item name="android:statusBarColor">@color/ic_launcher_background_light</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.Dark">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background_dark</item>
        <item name="android:background">@drawable/splash_dark</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background_dark</item>
        <item name="android:statusBarColor">@color/ic_launcher_background_dark</item>
    </style>

    <style name="AppTheme.NoActionBarLaunch.Light">
        <item name="windowSplashScreenBackground">@color/ic_launcher_background_light</item>
        <item name="android:background">@drawable/splash_light</item>
        <item name="android:navigationBarColor">@color/ic_launcher_background_light</item>
        <item name="android:statusBarColor">@color/ic_launcher_background_light</item>
    </style>
</resources>
